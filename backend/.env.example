# Copy this file to .env and fill in real values.

# --- App ---
APP_NAME=ITFlow API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./itflow.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/itflow

# --- Firebase Authentication ---
# 1. Firebase console -> Project settings -> Service accounts -> Generate new private key
# 2. Save the JSON file in this folder (or point to its path below)
# 3. Set FIREBASE_ENABLED=true once ready; leave false to use the X-Dev-User-Email dev bypass
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Resend (transactional email) ---
# Get an API key at https://resend.com/api-keys
# The from-address domain must be verified in your Resend account.
EMAIL_ENABLED=false
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=ITFlow <notifications@yourdomain.com>

# --- Seed defaults ---
DEFAULT_ADMIN_EMAIL=admin@itflow.dev
DEFAULT_ADMIN_NAME=IT Administrator
